<section class="tab biography" data-group="primary" data-tab="biography">
  <div class="form-row flexrow">
    <div class="form-group">
      <label>{{localize "CEPHEUS.Career"}}</label>
      <input type="text" name="system.career" value="{{document.system.career}}" />
    </div>
    <div class="form-group">
      <label>{{localize "CEPHEUS.Terms"}}</label>
      <input type="number" name="system.terms" value="{{document.system.terms}}" min="0" />
    </div>
    <div class="form-group">
      <label>{{localize "CEPHEUS.Gender"}}</label>
      <input type="text" name="system.gender" value="{{document.system.gender}}" />
    </div>
  </div>

  <div class="biography-body">
    <label>{{localize "CEPHEUS.Appearance"}}</label>
    <textarea name="system.appearance" placeholder="Physical description...">{{document.system.appearance}}</textarea>

    <label>{{localize "CEPHEUS.PersonalGoals"}}</label>
    <textarea name="system.personalGoals" placeholder="What drives this character...">{{document.system.personalGoals}}</textarea>

    <label>{{localize "CEPHEUS.Biography"}}</label>
    <textarea name="system.biography" placeholder="Character biography...">{{document.system.biography}}</textarea>
  </div>
</section>
