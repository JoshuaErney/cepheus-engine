<header class="sheet-header flexrow">
  <img class="actor-portrait"
       src="{{document.img}}"
       alt="{{document.name}}"
       data-action="showPortraitArtwork" />

  <div class="header-fields">
    <h1 class="charname">
      {{#if editable}}
        <input type="text" name="name" value="{{document.name}}"
               placeholder="{{localize 'CEPHEUS.ActorName'}}" />
      {{else}}
        {{document.name}}
      {{/if}}
    </h1>

    <div class="header-row flexrow">
      <div class="upp-block">
        <span class="upp-label">{{localize "CEPHEUS.UPP"}}</span>
        <span class="upp-value">{{system.upp}}</span>
      </div>

      <div class="wound-badge wound-{{system.woundState}}">
        {{localize (concat "CEPHEUS.Wound" system.woundState)}}
        {{#if system.woundPenalty}}<span class="wound-penalty">({{cepheusSign system.woundPenalty}} all checks)</span>{{/if}}
      </div>
    </div>

    <div class="header-meta flexrow">
      {{#if system.age}}
        <div class="meta-item">
          <label>{{localize "CEPHEUS.Age"}}</label>
          {{#if editable}}
            <input type="number" name="system.age" value="{{system.age}}" min="18" />
          {{else}}
            <span>{{system.age}}</span>
          {{/if}}
        </div>
      {{/if}}

      <div class="meta-item">
        <label>{{localize "CEPHEUS.Credits"}}</label>
        {{#if editable}}
          <input type="number" name="system.credits" value="{{system.credits}}" min="0" />
        {{else}}
          <span>{{system.credits}}</span>
        {{/if}}
      </div>

      {{#if system.pension}}
        <div class="meta-item">
          <label>{{localize "CEPHEUS.Pension"}}</label>
          {{#if editable}}
            <input type="number" name="system.pension" value="{{system.pension}}" min="0" />
          {{else}}
            <span>{{system.pension}}</span>
          {{/if}}
        </div>
      {{/if}}

      {{!-- Chargen is character-only: the template is shared with NPCs, whose
            schema has none of the fields the chargen apply step writes. --}}
      {{#if isCharacter}}
        <div class="meta-item">
          <button type="button" class="chargen-btn" data-action="startChargen"
                  title="{{localize 'CEPHEUS.ChargenTitle'}}">
            <i class="fas fa-id-card"></i> {{localize "CEPHEUS.Chargen"}}
          </button>
        </div>
      {{/if}}

      <div class="meta-item damage-controls">
        <button type="button" class="dmg-btn" data-action="applyDamage"
                title="{{localize 'CEPHEUS.ApplyDamage'}}">
          <i class="fas fa-heart-broken"></i> {{localize "CEPHEUS.Damage"}}
        </button>
        <button type="button" class="dmg-btn heal" data-action="healDamage"
                title="{{localize 'CEPHEUS.HealDamage'}}">
          <i class="fas fa-medkit"></i> {{localize "CEPHEUS.Heal"}}
        </button>
        <button type="button" class="dmg-btn recover" data-action="fullRecovery"
                title="{{localize 'CEPHEUS.FullRecovery'}}">
          <i class="fas fa-undo"></i>
        </button>
      </div>
    </div>
  </div>
</header>
