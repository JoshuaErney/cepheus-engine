<section class="tab ship-statistics {{tab.cssClass}}" data-group="primary" data-tab="statistics">

  <div class="ship-stats-grid">

    {{!-- Drives ─────────────────────────────────────────────────────────── --}}
    <div class="ship-section">
      <h3 class="section-title">{{localize "CEPHEUS.Drives"}}</h3>

      <div class="stat-row flexrow">
        <div class="form-group">
          <label>{{localize "CEPHEUS.JumpRating"}}</label>
          {{#if editable}}
            <input type="number" name="system.jumpRating" value="{{system.jumpRating}}" min="0" max="6" />
          {{else}}
            <span class="stat-value">{{system.jumpRating}}</span>
          {{/if}}
        </div>
        <div class="form-group">
          <label>{{localize "CEPHEUS.ManeuverRating"}}</label>
          {{#if editable}}
            <input type="number" name="system.maneuverRating" value="{{system.maneuverRating}}" min="0" max="6" />
          {{else}}
            <span class="stat-value">{{system.maneuverRating}}</span>
          {{/if}}
        </div>
        <div class="form-group">
          <label>{{localize "CEPHEUS.PowerPlant"}}</label>
          {{#if editable}}
            <input type="number" name="system.powerPlant" value="{{system.powerPlant}}" min="0" max="6" />
          {{else}}
            <span class="stat-value">{{system.powerPlant}}</span>
          {{/if}}
        </div>
      </div>

      <div class="stat-row flexrow derived-row">
        <div class="derived-stat">
          <label>{{localize "CEPHEUS.FuelPerJump"}}</label>
          <span>{{system.fuelPerJump}}T</span>
        </div>
        <div class="derived-stat">
          <label>{{localize "CEPHEUS.FuelPerMonth"}}</label>
          <span>{{system.fuelPerMonth}}T</span>
        </div>
      </div>
    </div>

    {{!-- Hull & Armour ───────────────────────────────────────────────────── --}}
    <div class="ship-section">
      <h3 class="section-title">{{localize "CEPHEUS.HullArmor"}}</h3>

      <div class="stat-row flexrow">
        <div class="form-group">
          <label>{{localize "CEPHEUS.Armor"}}</label>
          {{#if editable}}
            <input type="number" name="system.armor" value="{{system.armor}}" min="0" />
          {{else}}
            <span class="stat-value">{{system.armor}}</span>
          {{/if}}
        </div>
        <div class="form-group">
          <label>{{localize "CEPHEUS.Hardpoints"}}</label>
          <span class="stat-value derived">{{system.hardpoints}}</span>
        </div>
      </div>
    </div>

    {{!-- Cargo & Crew ────────────────────────────────────────────────────── --}}
    <div class="ship-section">
      <h3 class="section-title">{{localize "CEPHEUS.CargoAndCrew"}}</h3>

      <div class="stat-row flexrow">
        <div class="form-group">
          <label>{{localize "CEPHEUS.CargoCapacity"}}</label>
          {{#if editable}}
            <input type="number" name="system.cargoCapacity" value="{{system.cargoCapacity}}" min="0" />
          {{else}}
            <span class="stat-value">{{system.cargoCapacity}}T</span>
          {{/if}}
        </div>
        <div class="form-group">
          <label>{{localize "CEPHEUS.CargoUsed"}}</label>
          {{#if editable}}
            <input type="number" name="system.cargoUsed" value="{{system.cargoUsed}}" min="0" />
          {{else}}
            <span class="stat-value">{{system.cargoUsed}}T</span>
          {{/if}}
        </div>
        <div class="form-group">
          <label>{{localize "CEPHEUS.FreeCargo"}}</label>
          <span class="stat-value derived">{{system.freeCargo}}T</span>
        </div>
      </div>

      <div class="stat-row flexrow">
        <div class="form-group">
          <label>{{localize "CEPHEUS.MinCrew"}}</label>
          {{#if editable}}
            <input type="number" name="system.crewMin" value="{{system.crewMin}}" min="0" />
          {{else}}
            <span class="stat-value">{{system.crewMin}}</span>
          {{/if}}
        </div>
        <div class="form-group">
          <label>{{localize "CEPHEUS.Credits"}}</label>
          {{#if editable}}
            <input type="number" name="system.credits" value="{{system.credits}}" min="0" />
          {{else}}
            <span class="stat-value">Cr{{system.credits}}</span>
          {{/if}}
        </div>
      </div>
    </div>

    {{!-- Space Combat ────────────────────────────────────────────────────── --}}
    <div class="ship-section">
      <h3 class="section-title">{{localize "CEPHEUS.SpaceCombat"}}</h3>

      <div class="stat-row flexrow combat-actions">
        <button type="button" data-action="rollInitiative">
          <i class="fas fa-dice-d6"></i> {{localize "CEPHEUS.RollInitiative"}}
        </button>
        <button type="button" data-action="applyShipHit">
          <i class="fas fa-burst"></i> {{localize "CEPHEUS.ApplyHit"}}
        </button>
      </div>

      <div class="system-hits-grid">
        {{#each systemHitRows as |row|}}
          <div class="system-hit-row flexrow">
            <label>{{localize row.label}}</label>
            <div class="hit-track">
              <button type="button" data-action="adjustSystemHit" data-system="{{row.key}}" data-delta="-1"
                      title="{{localize 'CEPHEUS.Repair'}}">−</button>
              <span class="hit-value">{{row.value}}/3</span>
              <button type="button" data-action="adjustSystemHit" data-system="{{row.key}}" data-delta="1"
                      title="{{localize 'CEPHEUS.ApplyHit'}}">+</button>
            </div>
          </div>
        {{/each}}
      </div>
    </div>

  </div>
</section>
