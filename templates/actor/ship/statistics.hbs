<section class="tab ship-statistics" data-group="primary" data-tab="statistics">

  <div class="ship-stats-grid">

    {{!-- Drives ─────────────────────────────────────────────────────────── --}}
    <div class="ship-section">
      <h3 class="section-title">{{localize "CEPHEUS.Drives"}}</h3>

      <div class="stat-row flexrow">
        <div class="form-group">
          <label>{{localize "CEPHEUS.JumpRating"}}</label>
          {{#if editable}}
            <input type="number" name="system.jumpRating" value="{{jumpRating}}" min="0" max="6" />
          {{else}}
            <span class="stat-value">{{jumpRating}}</span>
          {{/if}}
        </div>
        <div class="form-group">
          <label>{{localize "CEPHEUS.ManeuverRating"}}</label>
          {{#if editable}}
            <input type="number" name="system.maneuverRating" value="{{maneuverRating}}" min="0" max="6" />
          {{else}}
            <span class="stat-value">{{maneuverRating}}</span>
          {{/if}}
        </div>
        <div class="form-group">
          <label>{{localize "CEPHEUS.PowerPlant"}}</label>
          {{#if editable}}
            <input type="number" name="system.powerPlant" value="{{powerPlant}}" min="0" max="6" />
          {{else}}
            <span class="stat-value">{{powerPlant}}</span>
          {{/if}}
        </div>
      </div>

      <div class="stat-row flexrow derived-row">
        <div class="derived-stat">
          <label>{{localize "CEPHEUS.FuelPerJump"}}</label>
          <span>{{fuelPerJump}}T</span>
        </div>
        <div class="derived-stat">
          <label>{{localize "CEPHEUS.FuelPerMonth"}}</label>
          <span>{{fuelPerMonth}}T</span>
        </div>
      </div>
    </div>

    {{!-- Hull & Armour ───────────────────────────────────────────────────── --}}
    <div class="ship-section">
      <h3 class="section-title">{{localize "CEPHEUS.HullArmor"}}</h3>

      <div class="stat-row flexrow">
        <div class="form-group">
          <label>{{localize "CEPHEUS.Armor"}}</label>
          {{#if editable}}
            <input type="number" name="system.armor" value="{{armor}}" min="0" />
          {{else}}
            <span class="stat-value">{{armor}}</span>
          {{/if}}
        </div>
        <div class="form-group">
          <label>{{localize "CEPHEUS.Hardpoints"}}</label>
          <span class="stat-value derived">{{hardpoints}}</span>
        </div>
      </div>
    </div>

    {{!-- Cargo & Crew ────────────────────────────────────────────────────── --}}
    <div class="ship-section">
      <h3 class="section-title">{{localize "CEPHEUS.CargoAndCrew"}}</h3>

      <div class="stat-row flexrow">
        <div class="form-group">
          <label>{{localize "CEPHEUS.CargoCapacity"}}</label>
          {{#if editable}}
            <input type="number" name="system.cargoCapacity" value="{{cargoCapacity}}" min="0" />
          {{else}}
            <span class="stat-value">{{cargoCapacity}}T</span>
          {{/if}}
        </div>
        <div class="form-group">
          <label>{{localize "CEPHEUS.CargoUsed"}}</label>
          {{#if editable}}
            <input type="number" name="system.cargoUsed" value="{{cargoUsed}}" min="0" />
          {{else}}
            <span class="stat-value">{{cargoUsed}}T</span>
          {{/if}}
        </div>
        <div class="form-group">
          <label>{{localize "CEPHEUS.FreeCargo"}}</label>
          <span class="stat-value derived">{{freeCargo}}T</span>
        </div>
      </div>

      <div class="stat-row flexrow">
        <div class="form-group">
          <label>{{localize "CEPHEUS.MinCrew"}}</label>
          {{#if editable}}
            <input type="number" name="system.crewMin" value="{{crewMin}}" min="0" />
          {{else}}
            <span class="stat-value">{{crewMin}}</span>
          {{/if}}
        </div>
        <div class="form-group">
          <label>{{localize "CEPHEUS.Credits"}}</label>
          {{#if editable}}
            <input type="number" name="system.credits" value="{{credits}}" min="0" />
          {{else}}
            <span class="stat-value">Cr{{credits}}</span>
          {{/if}}
        </div>
      </div>
    </div>

  </div>
</section>
