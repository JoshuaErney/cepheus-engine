<section class="tab ship-components {{tab.cssClass}}" data-group="primary" data-tab="components">

  <div class="tab-controls flexrow">
    <div class="component-totals">
      <span>{{localize "CEPHEUS.TonnageUsed"}}: <strong>{{system.usedTonnage}}T</strong></span>
      <span>{{localize "CEPHEUS.PowerUsed"}}: <strong>{{system.usedPower}}</strong></span>
    </div>
    <button type="button" data-action="createItem" data-type="shipComponent">
      <i class="fas fa-plus"></i> {{localize "CEPHEUS.AddComponent"}}
    </button>
  </div>

  <table class="components-table">
    <thead>
      <tr>
        <th>{{localize "CEPHEUS.ComponentName"}}</th>
        <th>{{localize "CEPHEUS.Tonnage"}}</th>
        <th>{{localize "CEPHEUS.PowerRequired"}}</th>
        <th>{{localize "CEPHEUS.Cost"}}</th>
        <th>{{localize "CEPHEUS.Hits"}}</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {{#each components as |item|}}
        <tr class="component-row" data-item-id="{{item.id}}">
          <td class="component-name">
            <button type="button" class="item-name-btn" data-action="editItem" data-item-id="{{item.id}}">
              {{item.name}}
            </button>
            {{#if item.system.componentType}}
              <span class="component-type-tag">{{item.system.componentType}}</span>
            {{/if}}
            {{#if item.system.weaponType}}
              <span class="component-type-tag weapon-tag">
                {{localize (lookup ../weaponTypeLabels item.system.weaponType)}}
                ({{localize (lookup ../mountLabels item.system.mount)}})
              </span>
            {{/if}}
          </td>
          <td class="component-tonnage">{{item.system.tonnage}}T</td>
          <td class="component-power">{{item.system.powerRequired}}</td>
          <td class="component-cost">Cr{{item.system.cost}}</td>
          <td class="component-hits">
            {{#if item.system.weaponType}}
              <div class="hit-track">
                <button type="button" data-action="adjustMountHit" data-item-id="{{item.id}}" data-delta="-1"
                        title="{{localize 'CEPHEUS.Repair'}}">−</button>
                <span class="hit-value">{{item.system.hits}}/3</span>
                <button type="button" data-action="adjustMountHit" data-item-id="{{item.id}}" data-delta="1"
                        title="{{localize 'CEPHEUS.ApplyHit'}}">+</button>
              </div>
            {{/if}}
          </td>
          <td class="item-controls">
            {{#if item.system.weaponType}}
              <button type="button" data-action="rollAttack" data-item-id="{{item.id}}"
                      title="{{localize 'CEPHEUS.RollAttack'}}">
                <i class="fas fa-dice-d6"></i>
              </button>
              <button type="button" data-action="rollWeaponDamage" data-item-id="{{item.id}}"
                      title="{{localize 'CEPHEUS.RollDamage'}}">
                <i class="fas fa-burst"></i>
              </button>
            {{/if}}
            <button type="button" data-action="editItem" data-item-id="{{item.id}}"
                    title="{{localize 'CEPHEUS.Edit'}}">
              <i class="fas fa-edit"></i>
            </button>
            <button type="button" data-action="deleteItem" data-item-id="{{item.id}}"
                    title="{{localize 'CEPHEUS.Delete'}}">
              <i class="fas fa-trash"></i>
            </button>
          </td>
        </tr>
      {{else}}
        <tr>
          <td colspan="6" class="empty-row">{{localize "CEPHEUS.NoComponents"}}</td>
        </tr>
      {{/each}}
    </tbody>
  </table>

</section>
