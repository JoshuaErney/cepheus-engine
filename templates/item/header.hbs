<header class="sheet-header flexrow">
  <img class="item-icon"
       src="{{document.img}}"
       alt="{{document.name}}"
       data-action="showPortraitArtwork" />

  <div class="header-fields">
    <h1>
      {{#if editable}}
        <input type="text" name="name" value="{{document.name}}"
               placeholder="{{localize 'CEPHEUS.ItemName'}}" />
      {{else}}
        {{document.name}}
      {{/if}}
    </h1>
    <div class="item-type-label">
      {{localize (concat "TYPES.Item." itemType)}}
    </div>
    {{#if (eq itemType "weapon")}}
      {{#if hasActor}}
        <div class="item-roll-btns">
          <button type="button" data-action="rollAttack"
                  title="{{localize 'CEPHEUS.RollAttack'}}">
            <i class="fas fa-dice-d6"></i> {{localize "CEPHEUS.RollAttack"}}
          </button>
          <button type="button" data-action="rollDamage"
                  title="{{localize 'CEPHEUS.RollDamage'}}">
            <i class="fas fa-burst"></i> {{localize "CEPHEUS.RollDamage"}}
          </button>
        </div>
      {{/if}}
    {{/if}}
  </div>
</header>
